# --- Dostęp do modelu (Meta Model API przez LiteLLM) ---
META_API_KEY=wklej-tutaj-swoj-klucz
# META_API_BASE=https://api.meta.ai/v1   # opcjonalne nadpisanie adresu API

# --- Parametry modelu ---
# Model w notacji LiteLLM. Tańszy wariant: meta/muse-spark-1.3-contributor
# (UWAGA: w wariancie contributor Meta może trenować na Twoich promptach).
LLM_MODEL=meta/muse-spark-1.3
LLM_TEMPERATURE=0.3
# minimal | low | medium | high | xhigh  (puste = domyślne modelu)
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60

# --- Silnik gry -> backend ---
BACKEND_URL=http://127.0.0.1:8000
