# =============================================================================
#  Tysiąc – Prompt Battles: konfiguracja
#  Skopiuj do .env i uzupełnij. Diagnostyka:  python -m backend.llm_config --ping
# =============================================================================

# --- Wybór dostawcy LLM (model DOMYŚLNY) ---------------------------------------
#   meta   – DOCELOWO: Muse Spark przez Meta Model API   (wymaga META_API_KEY)
#   groq   – TESTY: darmowy Groq, model Meta Llama        (wymaga GROQ_API_KEY)
#   gemini – TESTY: darmowy Google Gemini Flash           (wymaga GEMINI_API_KEY)
#   openai – ChatGPT: modele OpenAI GPT-5.6 (płatne API)  (wymaga OPENAI_API_KEY)
#            (akceptowane też: LLM_PROVIDER=chatgpt / gpt)
#   custom – dowolny model LiteLLM z LLM_MODEL            (np. ollama/llama3.1)
LLM_PROVIDER=groq

# --- Klucze API ----------------------------------------------------------------
# Wystarczy klucz wybranego dostawcy. Każdy DODATKOWY klucz udostępnia modele tego
# dostawcy w interfejsie – np. Bot A na Groq, Bot B na Gemini w jednej partii.
META_API_KEY=
# Darmowy klucz Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Darmowy klucz Gemini (Google AI Studio): https://aistudio.google.com/apikey
# (akceptowany jest też GOOGLE_API_KEY)
GEMINI_API_KEY=
# Klucz OpenAI (ChatGPT): https://platform.openai.com/api-keys
# UWAGA: API OpenAI jest płatne – bez doładowanych środków dostaniesz błąd insufficient_quota.
OPENAI_API_KEY=

# --- Model (opcjonalnie – puste = domyślny model dostawcy) ---------------------
# Domyślne:  meta   -> meta/muse-spark-1.3
#            groq   -> groq/llama-3.3-70b-versatile
#            gemini -> gemini/gemini-flash-latest   (alias zawsze wskazujący bieżący Flash)
#            openai -> openai/gpt-5.6-terra         (zbalansowany; luna = najtańszy, sol = najmocniejszy)
# Nazwa bez prefiksu dostaje prefiks dostawcy (llama-3.1-8b-instant -> groq/llama-3.1-8b-instant).
# Inne opcje: groq: llama-3.1-8b-instant (szybszy), meta-models/muse-spark-open (preview);
#             gemini: gemini-flash-lite-latest (lżejszy) lub konkretna wersja, np. gemini-2.5-flash;
#             openai: gpt-5.6-luna, gpt-5.6-sol. Nazwy gpt-…/o… bez prefiksu trafiają zawsze do OpenAI;
#             otwarty gpt-oss na Groq zapisuj jako groq/openai/gpt-oss-120b.
LLM_MODEL=

# Modele zapasowe (po przecinku), używane gdy główny NIE ISTNIEJE lub ma awarię
# (sieć/5xx) – nigdy przy limicie zapytań. Puste = domyślne dostawcy
# (groq: llama-3.1-8b-instant, gemini: gemini-flash-lite-latest, openai: gpt-5.6-luna);
# "none" = wyłączone.
LLM_FALLBACK_MODELS=

# --- Parametry wywołania (puste = dobierane osobno dla każdego modelu) ---------
# Temperatura. Puste: 0.3 dla Meta/Groq; dla Gemini i OpenAI nie wysyłamy (Gemini 3
# zaleca 1.0, a rozumujące GPT-5.x przyjmują tylko wartość domyślną).
LLM_TEMPERATURE=
# minimal | low | medium | high | xhigh | none.  Puste = domyślne dostawcy
# (meta, gemini, openai: low – ogranicza "myślenie" i koszt; groq/Llama: nie wysyłamy).
LLM_REASONING_EFFORT=
# Tryb JSON (response_format=json_object). Puste = według dostawcy.
LLM_JSON_MODE=
LLM_TIMEOUT=60
# Ponowienia przy NIEPOPRAWNYM RUCHU (model dostaje informację o błędzie).
LLM_MAX_RETRIES=2
# Ponowienia przy błędach sieci / timeout / 5xx (potem ewentualnie model zapasowy).
LLM_TRANSIENT_RETRIES=2

# Limit zapytań (HTTP 429): czekamy i ponawiamy TEN SAM model – nigdy zapasowy.
# Czas czekania: Retry-After / retryDelay od dostawcy, a bez nich backoff 2s, 4s, 8s…
# (maks. 30s na raz). Wyczerpany limit DOBOWY (Gemini "PerDay", Groq RPD) = od razu błąd.
LLM_RATE_LIMIT_RETRIES=5
LLM_RATE_LIMIT_BASE_DELAY=2
# Łączny limit czekania na jedno wywołanie (s). Trzymaj poniżej timeoutu klienta (domyślnie 180s).
LLM_RATE_LIMIT_MAX_WAIT=90

# --- Tylko dla LLM_PROVIDER=custom ------------------------------------------------
# Nazwa zmiennej z kluczem (jeśli model go wymaga) i własny adres API (np. Ollama):
# LLM_API_KEY_ENV=OPENROUTER_API_KEY
# LLM_API_BASE=http://localhost:11434

# --- Solver C++ (analiza ruchów: Q i strata, solver/tysiac_solver.cpp) -----------
# Przy starcie serwera solver jest kompilowany automatycznie (potrzebny g++/clang++/MSVC);
# ręcznie: python -m solver.build. Bez kompilatora gra działa, tylko bez analizy.
SOLVER_ENABLED=1
SOLVER_AUTO_BUILD=1
# Liczba losowanych układów kart ("światów") na ocenę ruchu: więcej = dokładniej i wolniej.
SOLVER_SAMPLES=100
# Wątki solvera (puste = min(liczba rdzeni, 4)) i rozmiar tablicy transpozycji (2^bity
# wpisów, ~24 MB na wątek przy 20).
SOLVER_THREADS=
SOLVER_TT_BITS=20
SOLVER_TIMEOUT=60
# Własna ścieżka do skompilowanego solvera (opcjonalnie)
# TYSIAC_SOLVER_PATH=

# --- Silnik gry -> backend --------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
